# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_48_CHARACTERS
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
# Set 0 locally. In production, set only the verified ingress proxy count (0–3).
TRUST_PROXY_HOPS=
DB_POOL_MAX=3
DATABASE_SSL=verify
MAX_UPLOAD_MB=250
RETENTION_HOURS=2
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FPCALC_PATH=
GEMINI_API_KEY=
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_REQUEST_TIMEOUT_MS=180000

# Optional password-reset email (Resend)
APP_BASE_URL=https://your-vidora-domain.example
RESEND_API_KEY=
RESEND_FROM=Vidora AI <no-reply@your-verified-domain.example>

# Optional generative video-to-video transformation (Runway Dev; credits required)
RUNWAYML_API_SECRET=
