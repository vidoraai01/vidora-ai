{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidora-ai",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "previews": {}
}
